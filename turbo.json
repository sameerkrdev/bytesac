{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "env": [
        "API_ORIGIN"
      ],
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "lint": {
      "dependsOn": [
        "transit"
      ]
    },
    "check-types": {
      "dependsOn": [
        "transit"
      ]
    },
    "test": {
      "dependsOn": [
        "transit"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.test*"
      ],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_ADMIN_DATABASE_URL",
        "TEST_REDIS_URL"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
