# infra/server/migrate.env — the schema owner, used only by `docker compose --profile tools run --rm migrate`.
# Copy to infra/server/migrate.env, fill in, chmod 600. Never commit it.
#
# Supabase SESSION pooler (IPv4, port 5432) with the postgres role: user "postgres.<project-ref>".
# The direct connection (db.<ref>.supabase.co) is IPv6-only and does not work from a default GCP VM.
MIGRATOR_DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
