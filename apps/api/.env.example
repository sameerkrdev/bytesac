# Copy to apps/api/.env. The API and the worker share this file.
# The API exits at startup if a required value is missing or empty.
# Server
NODE_ENV=development
PORT=4000
# error | warn | info | http | debug | silent (@repo/logger). Unset defaults to debug outside production and info in production.
LOG_LEVEL=info

# Database & Redis (runtime role is least privilege; local: see README "Local setup")
DATABASE_URL=postgres://bytesac_api:bytesac_api_dev@localhost:54329/bytesac_dev
REDIS_URL=redis://localhost:63799/0

# Auth & sessions (each secret must be at least 32 characters)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN_PEPPER=
OTP_HMAC_SECRET=
AUTH_DOMAIN=localhost:3000
AUTH_URI=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Digits = hops, true/false = boolean, otherwise an IP/CIDR/keyword list (e.g. TRUST_PROXY=1 behind a CDN)
TRUST_PROXY=loopback
# Edge header for client country (e.g. CF-IPCountry). Unset = geo ignored; edge MUST strip client-supplied values
GEO_COUNTRY_HEADER=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Bytesac <no-reply@example.com>

# SMS (Twilio Verify)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_ALLOWED_COUNTRIES=IN,US,GB,SG,AE

# Alchemy RPC for EVM, Solana, and Bitcoin (Bitcoin REST needs the UTXO add-on). Required; a placeholder works until you hit chain paths.
ALCHEMY_API_KEY=

# Cloudflare R2 (private bucket, S3 API; see README "Cloudflare R2")
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Market data (optional: empty = prices report unavailable)
COINMARKETCAP_API_KEY=

# AI — Google Gemini (optional: empty = AI search/embeddings off; keyword search still works)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Routing and execution (empty disables the feature that needs it)
# LI.FI: empty key → quotes fail with ROUTE_UNAVAILABLE
LIFI_API_KEY=
LIFI_INTEGRATOR=bytesac
ROUTE_PROVIDER_ORDER=lifi

# Platform keys (plain secrets for now; KMS before launch): Solana = base58 of 64-byte secret key; EVM = 0x private key
SOLANA_FEE_PAYER_SECRET=
EVM_GAS_WALLET_SECRET=
# Owner address of the platform USDC token account that receives network fees
GAS_TREASURY_SOLANA_ADDRESS=
# Owner of the platform-fee USDC account. Must differ from the gas treasury.
# Required once any platform fee is above 0; empty refuses those plans with ROUTE_UNAVAILABLE.
REVENUE_TREASURY_SOLANA_ADDRESS=

# Push — Firebase (optional: empty = web push disabled; inbox and email still work)
FIREBASE_SERVICE_ACCOUNT=
# Optional: Expo access token with push security enabled (mobile push works without it)
EXPO_ACCESS_TOKEN=

# Test (vitest); the test database name must end in _test
TEST_DATABASE_URL=postgres://bytesac_api:bytesac_api_dev@localhost:54329/bytesac_test
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:54329/bytesac_test
TEST_REDIS_URL=redis://localhost:63799/1
