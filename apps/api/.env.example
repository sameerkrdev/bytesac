NODE_ENV=development
PORT=4000
# error | warn | info | http | debug | silent (read by @repo/logger)
LOG_LEVEL=info
# Runtime role (least privilege), read by @repo/db. Local: see README "Local setup".
DATABASE_URL=postgres://bytesac_api:bytesac_api_dev@localhost:54329/bytesac_dev
REDIS_URL=redis://localhost:63799/0
SESSION_TOKEN_PEPPER=
OTP_HMAC_SECRET=
ALCHEMY_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Bytesac <no-reply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_ALLOWED_COUNTRIES=IN,US,GB,SG,AE
AUTH_DOMAIN=localhost:3000
AUTH_URI=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Behind a load balancer/CDN set the hop count (e.g. TRUST_PROXY=1). Digits = hops, true/false = boolean, otherwise an IP/CIDR/keyword list.
TRUST_PROXY=loopback
# Cloudflare R2 (private bucket, S3 API): see README "Cloudflare R2"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# CoinMarketCap Pro API key for asset market prices (optional: empty = prices report unavailable)
COINMARKETCAP_API_KEY=
# Google Gemini (optional: empty = AI search and embeddings disabled; keyword search still works)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# First investment and exit (Spec 8; all optional, empty disables the feature that needs it)
# LI.FI route provider (empty key: quotes fail with ROUTE_UNAVAILABLE)
LIFI_API_KEY=
# LIFI_INTEGRATOR=bytesac
# ROUTE_PROVIDER_ORDER=lifi
# Platform keys, plain secrets for now (KMS before launch): Solana fee payer as base58 of the 64-byte secret key, EVM gas wallet as a 0x private key
SOLANA_FEE_PAYER_SECRET=
EVM_GAS_WALLET_SECRET=
# Owner address of the platform USDC token account that receives network fees
GAS_TREASURY_SOLANA_ADDRESS=
# Owner address of the platform USDC token account that receives platform fees (must differ from the gas treasury; empty disables platform fees)
REVENUE_TREASURY_SOLANA_ADDRESS=
# Test (vitest); the test database name must end in _test
TEST_DATABASE_URL=postgres://bytesac_api:bytesac_api_dev@localhost:54329/bytesac_test
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:54329/bytesac_test
TEST_REDIS_URL=redis://localhost:63799/1

# Optional: edge header carrying the client country (e.g. CF-IPCountry). Unset = geo signal ignored. The edge MUST strip client-supplied values of this header.
GEO_COUNTRY_HEADER=
