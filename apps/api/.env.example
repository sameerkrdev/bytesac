NODE_ENV=development
PORT=4000
# error | warn | info | http | debug | silent (read by @repo/logger)
LOG_LEVEL=info
# Runtime role (least privilege), read by @repo/db. Local: see README "Local setup".
DATABASE_URL=postgres://bytesac_api:bytesac_api_dev@localhost:54329/bytesac_dev
REDIS_URL=redis://localhost:63799/0
SESSION_TOKEN_PEPPER=
OTP_HMAC_SECRET=
ALCHEMY_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Bytesac <no-reply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_ALLOWED_COUNTRIES=IN,US,GB,SG,AE
AUTH_DOMAIN=localhost:3000
AUTH_URI=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Behind a load balancer/CDN set the hop count (e.g. TRUST_PROXY=1). Digits = hops, true/false = boolean, otherwise an IP/CIDR/keyword list.
TRUST_PROXY=loopback
# Cloudflare R2 (private bucket, S3 API): see README "Cloudflare R2"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# CoinMarketCap Pro API key for asset market prices (optional: empty = prices report unavailable)
COINMARKETCAP_API_KEY=
# Test (vitest); the test database name must end in _test
TEST_DATABASE_URL=postgres://bytesac_api:bytesac_api_dev@localhost:54329/bytesac_test
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:54329/bytesac_test
TEST_REDIS_URL=redis://localhost:63799/1
