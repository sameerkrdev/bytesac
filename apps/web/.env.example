# Copy to apps/web/.env.local. Public NEXT_PUBLIC_* values are inlined at build time.

# Server-only. Next rewrites /api/* to this origin. Browsers never call the API directly.
API_ORIGIN=http://localhost:4000

# Public origin of this web app. Also the Reown AppKit metadata URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Reown (WalletConnect) Cloud project id. Wallet connect does nothing without it.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Web push (optional). All five must be set or the Profile push toggle stays hidden.
# Public Firebase web-app identifiers, not secrets. The API still needs FIREBASE_SERVICE_ACCOUNT.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Store badges (optional). Unset shows "Coming soon".
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Mock API port for `pnpm --filter web mock-api`. Default 4000.
# MOCK_API_PORT=4000
