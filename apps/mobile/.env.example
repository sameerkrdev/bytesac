# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are inlined when the dev client or EAS build is created.
# Android emulator reaches the host via 10.0.2.2; a physical device needs the host LAN IP or a tunnel.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
# Same Reown (WalletConnect) Cloud project as the web app, or a dedicated one.
EXPO_PUBLIC_REOWN_PROJECT_ID=
# Web origin for "Continue on web" (Bitcoin steps, manager and ops). No default: unset replaces those buttons with plain text.
EXPO_PUBLIC_WEB_URL=
# QA screenshots only (Expo web + ?as=investor|manager|ops|new against the local mock API). Never set on a real build.
# EXPO_PUBLIC_MOCK_SESSION=1
# Soft launch: show the team preview login before the wallet sign-in (ADR-022). Leave unset when the API gate is off.
# EXPO_PUBLIC_PREVIEW_GATE=1
