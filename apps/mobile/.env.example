# Android emulator reaches the host via 10.0.2.2; physical devices need the host LAN IP or a tunnel.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_REOWN_PROJECT_ID=
# Web app origin for "Continue on web" handoffs (Bitcoin steps, manager and ops areas). Defaults to https://bytesac.com.
EXPO_PUBLIC_WEB_URL=
