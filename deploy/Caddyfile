# HTTPS and reverse proxy for the single-VM deployment (deploy/docker-compose.yml).
# Caddy obtains and renews Let's Encrypt certificates for both domains automatically (ports 80 and 443 must be open
# and both DNS names must point at this VM).
#
# Client IP: with no trusted_proxies configured, Caddy ignores any X-Forwarded-For sent by the client and sets it to
# the real remote address. That is the overwrite the API's per-IP rate limits rely on (docs/engineering/DEPLOYMENT.md).
# If you put Cloudflare's proxy in front, add its ranges under `servers { trusted_proxies ... }` and set
# GEO_COUNTRY_HEADER=CF-IPCountry in api.env.

{
	email {$ACME_EMAIL}
}

# Web app (also serves /api/* to browsers through the Next.js rewrite)
{$WEB_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# Public API for the mobile app
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}
