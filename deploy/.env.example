# deploy/.env — read by docker compose (domains and public web build settings). Not secrets, but keep it out of git.

# Public DNS names pointing at this VM (Caddy issues certificates for both)
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
# Let's Encrypt account email (expiry notices)
ACME_EMAIL=you@example.com

# Web build (inlined into the web image at build time)
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Only with --profile selfhost-db
POSTGRES_PASSWORD=
