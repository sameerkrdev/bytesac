# deploy/api.env — production settings for the API and the worker (deploy/docker-compose.yml reads this file).
# Copy to deploy/api.env on the server, fill it in, then: chmod 600 api.env. Never commit it.
# Step-by-step source of every value: docs/engineering/DEPLOY-GCP.md
#
# REDIS_URL, PORT and TRUST_PROXY are set by docker-compose.yml and override anything written here.

# ---- Server ----------------------------------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# ---- Database (Supabase, transaction pooler, IPv4) -------------------------------------------------------------------
# Runtime role bytesac_api (least privilege, no DELETE). User is "bytesac_api.<project-ref>", port 6543.
# Set its password first (DEPLOY-GCP.md §17.3), and URL-encode special characters in it.
DATABASE_URL=postgresql://bytesac_api.<project-ref>:<runtime-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- Auth and sessions -----------------------------------------------------------------------------------------------
# Two different random values, each from: openssl rand -hex 32
SESSION_TOKEN_PEPPER=
OTP_HMAC_SECRET=
# The web host users sign in on (no scheme). Must match the site the wallet sees.
AUTH_DOMAIN=app.example.com
# The public web origin (used in sign-in messages and links in emails)
AUTH_URI=https://app.example.com
# Origins allowed to send cookie-authenticated requests (comma-separated)
ALLOWED_ORIGINS=https://app.example.com
COOKIE_SECURE=true
# Leave empty unless a proxy that overwrites a country header sits in front (for example Cloudflare: CF-IPCountry)
GEO_COUNTRY_HEADER=

# ---- Email (Resend) --------------------------------------------------------------------------------------------------
RESEND_API_KEY=re_...
# Sender on a domain you verified in Resend
EMAIL_FROM=Bytesac <no-reply@mail.example.com>

# ---- SMS (Twilio Verify) ---------------------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=VA...
# ISO country codes users may verify a phone in; enable the same countries in Twilio Verify geo permissions
SMS_ALLOWED_COUNTRIES=IN,US,GB,SG,AE

# ---- Chain data (Alchemy) --------------------------------------------------------------------------------------------
ALCHEMY_API_KEY=

# ---- Files (Cloudflare R2, private bucket) ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bytesac-files

# ---- Optional services (empty disables the feature) ------------------------------------------------------------------
COINMARKETCAP_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ---- Routing (LI.FI): required before anyone can invest --------------------------------------------------------------
LIFI_API_KEY=
LIFI_INTEGRATOR=bytesac
ROUTE_PROVIDER_ORDER=lifi

# ---- Platform wallets: leave empty until you are ready to fund them (investing stays disabled) ----------------------
# Solana fee payer: base58 of the 64-byte secret key. EVM gas wallet: 0x-prefixed private key.
SOLANA_FEE_PAYER_SECRET=
EVM_GAS_WALLET_SECRET=
# Owner addresses (public) of the two USDC-on-Solana treasuries; they must differ
GAS_TREASURY_SOLANA_ADDRESS=
REVENUE_TREASURY_SOLANA_ADDRESS=

# ---- Push (optional) -------------------------------------------------------------------------------------------------
# Firebase service-account JSON on ONE line (web push)
FIREBASE_SERVICE_ACCOUNT=
# Expo access token, only if you enable Expo enhanced push security (mobile push works without it)
EXPO_ACCESS_TOKEN=
